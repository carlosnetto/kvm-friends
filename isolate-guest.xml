<filter name='isolate-guest' chain='root'>
  <!-- Allow the DHCP exchange with the host's dnsmasq (the only host contact
       a guest needs; DNS comes from public resolvers via default-net.xml). -->
  <rule action='accept' direction='out' priority='100'>
    <udp dstportstart='67' dstportend='67'/>
  </rule>

  <!-- Drop anything the VM *initiates* (state NEW) toward: the libvirt
       bridge itself (the host's virbr0 address AND sibling VMs, both on
       this /24 — matches default-net.xml), link-local, and CGNAT (covers
       the host's Tailscale IP). state='NEW' keeps host-initiated SSH into
       the VM working (replies are ESTABLISHED and pass). The placeholder
       rule below is filled in by setup-network.sh at define time with
       this host's own physical-NIC subnet (see CLAUDE.md, "Network
       isolation"), so guests can't reach colo neighbors / other boxes on
       that segment either — the exact range differs per host. -->
  <rule action='drop' direction='out' priority='500'>
    <all dstipaddr='192.168.122.0' dstipmask='24' state='NEW'/>
  </rule>
  <rule action='drop' direction='out' priority='501'>
    <all dstipaddr='169.254.0.0' dstipmask='16' state='NEW'/>
  </rule>
  <rule action='drop' direction='out' priority='502'>
    <all dstipaddr='100.64.0.0' dstipmask='10' state='NEW'/>
  </rule>
  @HOST_LAN_RULE@

  <!-- The NAT network is IPv4-only; drop all IPv6 so the guest can't reach
       the host via fe80:: link-local on the bridge. -->
  <rule action='drop' direction='inout' priority='600'>
    <ipv6/>
  </rule>

  <!-- Everything else (internet via the host's NAT, or Tailscale to public
       DERP relays / peers) is accepted by default. -->
</filter>
